# Copie para backend/.env (não versionado). Nada aqui é obrigatório para rodar localmente.
# DATABASE_URL=postgresql+psycopg://acervo:acervo@localhost:5432/acervo
# Geração das 8 peças, respostas do assistente e reescrita da pergunta
ANTHROPIC_API_KEY=
MODELO_CLAUDE=claude-sonnet-5-5
# Transcrição de áudio (Whisper) e, opcionalmente, embeddings
OPENAI_API_KEY=
# Embeddings: local (padrão, sem chave) | voyage | openai
PROVEDOR_EMBEDDINGS=local
VOYAGE_API_KEY=
# 1 = o Claude reescreve a pergunta antes da busca (mais acertos, 1 chamada extra)
REESCREVER_PERGUNTA=0
# Segredo compartilhado com o workflow do n8n (cabeçalho X-Webhook-Token)
N8N_TOKEN=
# As chaves acima também podem ser cadastradas em Configurações › Chaves de API (cifradas no banco; têm prioridade).
# Chave-mestra dessa cifra. Sem ela, é gerada em backend/storage/.chave-mestra. Em produção, defina e guarde num cofre.
# SEGREDO_MESTRE=
# Vídeo e áudio
LIMITE_MIDIA_MB=2048
PARTE_TRANSCRICAO_S=1200
# FFMPEG_BIN=  (vazio: ffmpeg do PATH ou o do pacote imageio-ffmpeg)
